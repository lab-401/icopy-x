# Dockerfile for cross-compiling PM3 client for iCopy-X
#
# Uses Ubuntu 16.04 (xenial) base with the default GCC 5.4 cross-compiler.
# GCC 7 from ubuntu-toolchain-r PPA is no longer available for xenial, so we
# use the default xenial cross-compiler and apply sed fixups for newer PM3
# releases (matching the CI workflow in .github/workflows/build-ipk.yml).
#
# Usage (from repo root):
#   docker build -f tools/docker/Dockerfile.pm3-client -t pm3-client-builder .
#   docker run --rm -v $(pwd)/build:/out pm3-client-builder
#
# Override PM3 version at runtime:
#   docker run --rm -e PM3_TAG=v4.XXXXX -v $(pwd)/build:/out pm3-client-builder

FROM ubuntu:16.04

# Xenial sources: amd64 from archive, armhf from ports
RUN echo 'deb [arch=amd64] http://archive.ubuntu.com/ubuntu/ xenial main restricted universe' > /etc/apt/sources.list && \
    echo 'deb [arch=amd64] http://archive.ubuntu.com/ubuntu/ xenial-updates main restricted universe' >> /etc/apt/sources.list && \
    echo 'deb [arch=armhf] http://ports.ubuntu.com/ubuntu-ports/ xenial main restricted universe' >> /etc/apt/sources.list && \
    echo 'deb [arch=armhf] http://ports.ubuntu.com/ubuntu-ports/ xenial-updates main restricted universe' >> /etc/apt/sources.list

# Install default xenial cross-toolchain (GCC 5.4)
RUN dpkg --add-architecture armhf && \
    apt-get update -qq && \
    apt-get install -y -qq \
        gcc-arm-linux-gnueabihf \
        g++-arm-linux-gnueabihf \
        make \
        pkg-config \
        git \
        file \
        zip \
        python3 \
        libbz2-dev:armhf \
        zlib1g-dev:armhf \
        liblz4-dev:armhf && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

ENV PKG_CONFIG_PATH=/usr/lib/arm-linux-gnueabihf/pkgconfig
ENV PKG_CONFIG_LIBDIR=/usr/lib/arm-linux-gnueabihf/pkgconfig
ENV PM3_PLATFORM=PM3ICOPYX
ENV PM3_REPO=https://github.com/RfidResearchGroup/proxmark3.git

# Default: resolve latest v4.x release at runtime.
ENV PM3_TAG=latest

COPY tools/patches/pm3_*.patch /patches/
COPY tools/pm3_build_contract.py /build-contract.py

CMD bash -c '\
    set -e && \
    if [ "${PM3_TAG}" = "latest" ]; then \
        PM3_TAG=$(git ls-remote --tags ${PM3_REPO} "v4.*" \
            | grep -v "\^{}" | sed "s|.*refs/tags/||" \
            | sort -t. -k1,1 -k2,2n | tail -1); \
        echo "Resolved latest release: ${PM3_TAG}"; \
    fi && \
    echo "Cloning RRG PM3 at ${PM3_TAG}..." && \
    git -c core.autocrlf=false clone --depth 1 --branch ${PM3_TAG} ${PM3_REPO} /tmp/pm3 && \
    cd /tmp/pm3 && \
    PM3_COMMIT=$(git rev-parse HEAD) && \
    python3 /build-contract.py prepare-client --source /tmp/pm3 \
        --commit "$PM3_COMMIT" --patch-dir /patches --profile device && \
    echo "GCC $(arm-linux-gnueabihf-gcc -dumpversion) compat fixups..." && \
    sed -i "s/-fstack-clash-protection//g" Makefile.defs client/Makefile && \
    if [ -f client/src/cmdhfaliro.c ]; then \
      sed -i "s/static const uint8_t protocol_marker\[\]/const uint8_t protocol_marker[]/" client/src/cmdhfaliro.c; \
    fi && \
    if [ -f client/src/cmdhfvas.c ]; then \
      sed -i "s/^static const uint16_t \(VAS_STATUS_[A-Z_]*\) = \(0x[0-9A-Fa-f]*\);/#define \1 \2/" client/src/cmdhfvas.c; \
    fi && \
    echo "Building PM3 client..." && \
    make -j$(nproc) client \
        PLATFORM=${PM3_PLATFORM} \
        CC=arm-linux-gnueabihf-gcc \
        CXX=arm-linux-gnueabihf-g++ \
        LD=arm-linux-gnueabihf-ld \
        "AR=arm-linux-gnueabihf-ar rcs" \
        RANLIB=arm-linux-gnueabihf-ranlib \
        cpu_arch=arm \
        SKIPQT=1 SKIPPYTHON=1 SKIPREVENGTEST=1 SKIPGD=1 SKIPBT=1 SKIPREADLINE=1 && \
    echo "Build complete." && \
    mkdir -p /out && \
    cp client/proxmark3 /out/proxmark3 && \
    echo "Binary: $(file /out/proxmark3)" && \
    cd client && \
    zip -r /out/lua.zip luascripts/ lualibs/ && \
    python3 /build-contract.py client --source /tmp/pm3 \
        --commit "$PM3_COMMIT" --tag "$PM3_TAG" --binary /out/proxmark3 \
        --lua /out/lua.zip --output /out/pm3_client_build.json && \
    echo "lua.zip: $(du -h /out/lua.zip | cut -f1)"'
