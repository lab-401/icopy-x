                            "align": "center"
                        },
                        {
                            "text": "UID: {uid}",
                            "size": "small",
                            "align": "center"
                        },
                        {
                            "text": "B4: {block4} | B5: {block5}",
                            "size": "small",
                            "align": "center"
                        },
                        {
                            "text": "B6: {block6} | B7: {block7}",
                            "size": "small",
                            "align": "center"
                        },
                        {
                            "text": "",
