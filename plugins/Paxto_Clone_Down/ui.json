                "keys": {
                    "OK": "set_state:paxton_prepare",
                    "M2": "set_state:paxton_prepare",
                    "M1": "run:do_back_from_write"
                }
            },
            "transitions": {
                "on_result.status==done": "clone_ok",
                "on_result.status==loaded": "loaded",
                "on_result.status==read_clone": "read_clone",
                "on_result.status==read_down": "read_down",
                "on_result.status==error": "error",
                "on_error": "error"
            }
        },
