{
    "plugin": true,
    "name": "Paxton Clone&Down",
    "version": "3.9.15",
    "initial_state": "init",
    "states": {
        "init": {
            "on_enter": "call:do_init",
            "screen": {
                "title": "Paxton Clone&Down",
                "content": {
                    "type": "text",
                    "lines": [
                        {
                            "text": "",
                            "size": "large"
                        },
                        {
                            "text": "",
                            "size": "large"
                        },
                        {
                            "text": "Loading...",
                            "size": "large",
                            "align": "center"
                        }
                    ]
                },
                "buttons": {
                    "left": null,
                    "right": null
                },
                "keys": {}
            },
            "transitions": {
                "on_result.status==ok": "menu",
                "on_error": "menu"
            }
        },
        "menu": {
            "screen": {
                "title": "Paxton Clone&Down",
                "content": {
                    "type": "list",
                    "style": "plain",
                    "items": [
                        {
                            "label": "Clone to Paxton",
                            "action": "call:do_start_clone"
                        },
                        {
                            "label": "Downgrade to EM4102",
                            "action": "call:do_start_down"
                        },
                        {
                            "label": "Load from log",
                            "action": "call:do_start_log"
                        }
                    ]
                },
                "buttons": {
                    "left": "Exit",
                    "right": "Select"
                },
                "keys": {
                    "UP": "scroll:-1",
                    "DOWN": "scroll:1",
                    "OK": "select",
                    "M2": "select",
                    "M1": "finish"
                }
            },
            "transitions": {
                "on_result.status==clone": "read_clone",
                "on_result.status==down": "read_down",
                "on_result.status==log": "find_name",
                "on_result.status==error": "error",
                "on_error": "error"
            }
        },
        "read_clone": {
            "screen": {
                "title": "Clone to Paxton",
                "content": {
                    "type": "text",
                    "lines": [
                        {
                            "text": "",
                            "size": "large"
                        },
                        {
                            "text": "",
                            "size": "large"
                        },
                        {
                            "text": "Place Paxton fob",
                            "size": "large",
                            "align": "center"
                        },
                        {
                            "text": "on the reader",
                            "size": "large",
                            "align": "center"
                        },
                        {
                            "text": "",
                            "size": "large"
                        },
                        {
                            "text": "OK - read original fob",
                            "size": "medium",
                            "align": "center"
                        }
                    ]
                },
                "buttons": {
                    "left": "Back",
                    "right": "Read"
                },
                "keys": {
                    "OK": "run:do_read_clone",
                    "M2": "run:do_read_clone",
                    "M1": "set_state:menu"
                }
            },
            "transitions": {
                "on_result.status==found": "readed_clone",
                "on_result.status==error": "error",
                "on_error": "error"
            }
        },
        "readed_clone": {
            "screen": {
                "title": "Readed Paxton",
