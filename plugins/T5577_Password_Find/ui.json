    "firmware_notice": {
      "on_enter": "call:screen_firmware_notice",
      "on_exit": "call:clear_screen",
      "screen": {
        "title": "T5577 Password Find",
        "content": {
          "type": "text",
          "lines": []
        },
        "buttons": {
          "left": null,
          "right": "Exit"
        },
        "keys": {
          "M2": "finish",
          "OK": "finish",
          "UP": "call:info_up",
          "DOWN": "call:info_down"
        }
      }
    },
    "date_format": {
      "on_enter": "call:draw_date_format_menu",
      "on_exit": "call:clear_date_format_menu",
      "screen": {
        "title": "Date format",
        "content": {
          "type": "text",
          "lines": []
        },
        "buttons": {
          "left": "Back",
          "right": "Select"
        },
        "keys": {
          "UP": "call:format_up",
          "DOWN": "call:format_down",
          "OK": "call:choose_date_format",
          "M2": "call:choose_date_format",
          "M1": "set_state:menu"
        }
      },
      "transitions": {
        "on_result.status==ready": "date_count"
      }
    },
    "date_count": {
      "on_enter": "run:prepare_date_count",
      "screen": {
        "title": "Date Range",
        "content": {
          "type": "text",
          "lines": [
            {
              "text": "Counting passwords...",
              "align": "center",
              "size": "medium"
            }
          ],
          "y": 110
        },
        "buttons": {
          "left": null,
          "right": null
        },
        "keys": {}
      },
      "transitions": {
        "on_result.status==ready": "date_ready",
        "on_result.status==error": "error",
        "on_error": "error"
      }
    },
    "p1_failed_set": {
      "on_enter": "call:screen_p1_failed",
      "screen": {
        "title": "Set Password",
        "content": {
          "type": "text",
          "lines": []
        },
        "buttons": {
          "left": "Back",
          "right": "Retry"
        },
        "keys": {
          "M1": "set_state:menu",
          "M2": "set_state:precheck_set",
          "OK": "set_state:precheck_set",
          "UP": "call:info_up",
          "DOWN": "call:info_down"
        }
      },
      "on_exit": "call:clear_screen"
    }
  }
}
